<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainActivity">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/colorBackground"
            app:elevation="0dp"
            app:liftOnScroll="true">

            <!-- ======================================================== -->
            <!-- القسم العلوي القابل للطي عند التمرير (الهيدر + الإشعارات + المميزة) -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutCollapsibleHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp"
                app:layout_scrollFlags="scroll">

                <!-- 1. الهيدر الرئيسي الموحد -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginBottom="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- شعار المتجر المتوهج -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="46dp"
                        android:layout_height="46dp"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        app:cardCornerRadius="23dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorPrimary"
                        app:strokeWidth="1.5dp">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="2dp"
                            android:scaleType="centerCrop"
                            android:src="@mipmap/ic_launcher"
                            app:shapeAppearanceOverlay="@style/Shape.Circle" />
                    </com.google.android.material.card.MaterialCardView>

                    <!-- اسم المتجر والترحيب الديناميكي -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-black"
                            android:includeFontPadding="false"
                            android:text="متجر Abdullah"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtWelcomeSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="جميع التطبيقات المعدلة والآمنة 🛡️"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- أزرار الهيدر الموحدة -->
                    <LinearLayout
                        android:id="@+id/layoutHeaderActions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/btnThemeQuickToggle"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:clickable="true"
                            android:contentDescription="تبديل المظهر"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="9dp"
                            android:src="@drawable/ic_header_moon"
                            app:shapeAppearanceOverlay="@style/Shape.Circle"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/btnRefreshMain"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:clickable="true"
                            android:contentDescription="تحديث القائمة"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="9dp"
                            android:src="@drawable/ic_header_refresh"
                            app:shapeAppearanceOverlay="@style/Shape.Circle"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp"
                            app:tint="?attr/colorPrimary" />

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/btnMenu"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:clickable="true"
                            android:contentDescription="القائمة الجانبية"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="9dp"
                            android:src="@drawable/ic_menu"
                            app:shapeAppearanceOverlay="@style/Shape.Circle"
                            app:strokeColor="?attr/colorOutlineVariant"
                            app:strokeWidth="1dp"
                            app:tint="?attr/colorOnSurface" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 2. بطاقة التنبيهات العاجلة المطورة (أيقونة دائرية + حركة اختفاء ناعمة) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAnnouncement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1.25dp"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:layout_marginEnd="12dp"
                            app:cardBackgroundColor="?attr/colorPrimaryContainer"
                            app:cardCornerRadius="19dp"
                            app:cardElevation="0dp"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:contentDescription="إشعار المتجر"
                                android:src="@drawable/ic_announcement_megaphone"
                                app:tint="?attr/colorPrimary" />
                        </com.google.android.material.card.MaterialCardView>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/txtAnnouncementTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="إشعار هام من إدارة المتجر"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtAnnouncementBody"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:lineSpacingExtra="2dp"
                                android:textColor="?attr/colorOnSurface"
                                android:textSize="12.5sp"
                                tools:text="تم توفير تحديث جديد لجميع نسخ الواتساب ضد الحظر." />
                        </LinearLayout>

                        <ImageButton
                            android:id="@+id/btnDismissAnnouncement"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="6dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="إغلاق الإشعار"
                            android:src="@drawable/ic_close"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. بطاقة البانر التفاعلي للتطبيقات المميزة (سحب + تمرير تلقائي + نقاط كبسولية) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardHeroSpotlight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_hero_spotlight_gradient">

                        <!-- أيقونة خلفية مائية كبيرة تعطي عمقاً بصرياً -->
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/imgHeroWatermark"
                            android:layout_width="136dp"
                            android:layout_height="136dp"
                            android:layout_gravity="bottom|end"
                            android:layout_marginEnd="-20dp"
                            android:layout_marginBottom="-26dp"
                            android:alpha="0.11"
                            android:rotation="-14"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/Shape.Medium"
                            tools:src="@mipmap/ic_launcher" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="18dp"
                            android:paddingTop="15dp"
                            android:paddingBottom="13dp">

                            <!-- شريط الشارة العلوية + عداد التطبيقات المميزة -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtHeroBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_version_badge"
                                    android:backgroundTint="?attr/colorSurface"
                                    android:paddingHorizontal="10dp"
                                    android:paddingVertical="3dp"
                                    android:text="👑 مختارات المتجر • أحدث إصدار"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />

                                <Space
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1" />

                                <TextView
                                    android:id="@+id/txtHeroIndicator"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_version_badge"
                                    android:backgroundTint="?attr/colorSurface"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:fontFamily="sans-serif-black"
                                    android:foreground="?attr/selectableItemBackgroundBorderless"
                                    android:paddingHorizontal="9dp"
                                    android:paddingVertical="3dp"
                                    android:text="1 / 4"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <!-- صف بيانات التطبيق المميز (يتبدل بحركة انزلاق وتلاشي ناعمة) -->
                            <LinearLayout
                                android:id="@+id/layoutHeroContent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <com.google.android.material.imageview.ShapeableImageView
                                    android:id="@+id/imgHeroIcon"
                                    android:layout_width="60dp"
                                    android:layout_height="60dp"
                                    android:background="?attr/colorSurface"
                                    android:scaleType="centerCrop"
                                    app:shapeAppearanceOverlay="@style/Shape.Medium"
                                    app:strokeColor="?attr/colorOutlineVariant"
                                    app:strokeWidth="1dp"
                                    tools:src="@mipmap/ic_launcher" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="14dp"
                                    android:layout_marginEnd="10dp"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/txtHeroTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:ellipsize="end"
                                        android:fontFamily="sans-serif-black"
                                        android:includeFontPadding="false"
                                        android:lineSpacingExtra="2dp"
                                        android:maxLines="2"
                                        android:textAlignment="viewStart"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textSize="15.5sp"
                                        android:textStyle="bold"
                                        tools:text="ABWhatsApp العنابي ضد الحظر" />

                                    <TextView
                                        android:id="@+id/txtHeroSub"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="3dp"
                                        android:ellipsize="end"
                                        android:fontFamily="sans-serif-medium"
                                        android:maxLines="1"
                                        android:textAlignment="viewStart"
                                        android:textColor="?attr/colorOnPrimaryContainer"
                                        android:textSize="12sp"
                                        tools:text="عبدالله التميمي • v2.26.39.80 • 86 MB" />
                                </LinearLayout>

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnHeroAction"
                                    style="@style/Widget.Material3.Button.UnelevatedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="38dp"
                                    android:backgroundTint="?attr/colorPrimary"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:minWidth="74dp"
                                    android:paddingHorizontal="14dp"
                                    android:text="استعراض"
                                    android:textColor="?attr/colorOnPrimary"
                                    android:textSize="12sp"
                                    android:textStyle="bold"
                                    app:cornerRadius="19dp" />
                            </LinearLayout>

                            <!-- نقاط التنقل الكبسولية التفاعلية أسفل البانر -->
                            <LinearLayout
                                android:id="@+id/layoutHeroDots"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:gravity="center"
                                android:orientation="horizontal" />
                        </LinearLayout>
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- القسم المثبّت الذكي أثناء التمرير (البحث + الفرز + التصنيفات) -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutPinnedControls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/colorBackground"
                android:orientation="vertical"
                android:paddingTop="4dp"
                android:paddingBottom="6dp">

                <!-- 4. كبسولة البحث المتقدم + زر الفرز الدائري -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/searchCard"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="?attr/colorSurfaceVariant"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="بحث"
                                android:src="@drawable/ic_header_search"
                                app:tint="?attr/colorOnSurfaceVariant" />

                            <EditText
                                android:id="@+id/etSearch"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:hint="ابحث عن اسم التطبيق أو المطور.."
                                android:imeOptions="actionSearch"
                                android:inputType="text"
                                android:maxLines="1"
                                android:paddingHorizontal="10dp"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnSurface"
                                android:textColorHint="?attr/colorOutline"
                                android:textSize="14sp" />

                            <ImageButton
                                android:id="@+id/btnClearSearch"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="مسح البحث"
                                android:src="@drawable/ic_close"
                                android:visibility="gone"
                                app:tint="?attr/colorOnSurfaceVariant"
                                tools:visibility="visible" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- زر الفرز الذكي الدائري المدمج -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSortApps"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:contentDescription="ترتيب التطبيقات"
                        android:insetLeft="0dp"
                        android:insetTop="0dp"
                        android:insetRight="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:padding="0dp"
                        app:backgroundTint="?attr/colorSurfaceVariant"
                        app:cornerRadius="24dp"
                        app:icon="@drawable/ic_header_sort"
                        app:iconGravity="textStart"
                        app:iconPadding="0dp"
                        app:iconSize="20dp"
                        app:iconTint="?attr/colorPrimary"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- 5. شريط الفلاتر والتصنيفات (تمرير حر بعرض الشاشة) -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingHorizontal="18dp"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupCategories"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="الكل ✨"
                            app:chipCornerRadius="20dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipAbMods"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="نسخ عبدالله (AB)"
                            app:chipCornerRadius="20dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipObMods"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="نسخ عمر (OB)"
                            app:chipCornerRadius="20dp" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipShieldMods"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="درع الحماية 🛡️"
                            app:chipCornerRadius="20dp" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- 6. شريط الإحصائية السريعة وشارة الترتيب النشط -->
                <LinearLayout
                    android:id="@+id/layoutCatalogStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="18dp"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp">

                    <TextView
                        android:id="@+id/txtCatalogSummary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="جاري فحص قائمة التطبيقات..."
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/txtActiveSortLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_version_badge"
                        android:backgroundTint="?attr/colorSurfaceVariant"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="الأحدث ✨ ▾"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- مؤشر تحميل Material 3 العصري -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                android:visibility="gone"
                app:hideAnimationBehavior="outward"
                app:indicatorColor="?attr/colorPrimary"
                app:showAnimationBehavior="inward"
                app:trackColor="?attr/colorSurfaceVariant"
                app:trackCornerRadius="4dp"
                app:trackThickness="3dp" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- ======================================================== -->
        <!-- الشريط العائم المتقدم (Floating Pill Navigation Bar)      -->
        <!-- ======================================================== -->
        <include
            android:id="@+id/floatingNav"
            layout="@layout/view_floating_nav_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
