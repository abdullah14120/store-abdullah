<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1A222C"
    app:strokeColor="#2D3748"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <!-- أيقونة التطبيق مع تأثير الظل والزوايا -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAppIcon"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:scaleType="centerCrop"
            android:elevation="4dp"
            app:shapeAppearanceOverlay="@style/RoundedIcon"
            android:background="#2D3748" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم التطبيق"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/txtDeveloper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم المطور"
                android:textColor="@color/gray_light"
                android:textSize="12sp"
                android:layout_marginTop="2dp"
                android:alpha="0.8"/>

            <!-- كبسولة الإصدار الملونة -->
            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V 1.0.2"
                android:textColor="@color/secondary_cyan"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_version_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp" />
        </LinearLayout>

        <!-- زر التثبيت العصري -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تثبيت"
            android:textColor="@color/dark_background"
            android:textSize="13sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            android:minWidth="80dp"
            android:paddingHorizontal="12dp"
            app:backgroundTint="@color/secondary_cyan"
            app:rippleColor="@color/white" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
