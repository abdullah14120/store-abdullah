<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#1E293B"
    app:strokeColor="#334155"
    app:strokeWidth="1dp"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- أيقونة التطبيق: مع الـ transitionName للحركة العالمية -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAppIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:transitionName="transition_app_icon"
            app:shapeAppearanceOverlay="@style/RoundedIcon"
            android:background="#0F172A" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="16dp">

            <TextView
                android:id="@+id/txtAppName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="اسم التطبيق"
                android:textColor="#F8FAFC"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/txtDeveloper"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="بواسطة عبدالله التميمي"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif-medium"/>

            <!-- كبسولة الإصدار: تم تحديث الألوان لتناسب الهوية الجديدة -->
            <TextView
                android:id="@+id/txtVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="V 1.0.0"
                android:textColor="#22D3EE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_version_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- زر التفاعل: يستخدم الستايلات التي صممناها للألوان المتغيرة -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDownload"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="تحديث"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:minWidth="84dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:cornerRadius="20dp"
            android:backgroundTint="@color/secondary_cyan" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
