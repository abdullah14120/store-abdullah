<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.details.AppDetailsActivity">

    <!-- 1. شريط علوي يندمج مع الخلفية ويبرز عند التمرير -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetails"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="?attr/colorOnSurface"
            app:titleCentered="true"
            tools:title="تفاصيل التطبيق" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- ======================================================== -->
            <!-- 🎨 1. قسم الهيدر: الأيقونة، الاسم، المطور، وشارة الأمان -->
            <!-- ======================================================== -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDetailsIcon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerCrop"
                android:transitionName="transition_app_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/Shape.Medium"
                tools:src="@tools/sample/avatars" />

            <TextView
                android:id="@+id/txtDetailsName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="24dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintBottom_toTopOf="@id/txtDetailsDev"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgDetailsIcon"
                app:layout_constraintTop_toTopOf="@id/imgDetailsIcon"
                app:layout_constraintVertical_chainStyle="packed"
                tools:text="ABWhatsApp العنّابي" />

            <TextView
                android:id="@+id/txtDetailsDev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp"
                app:layout_constraintBottom_toTopOf="@id/txtVerifiedBadge"
                app:layout_constraintEnd_toEndOf="@id/txtDetailsName"
                app:layout_constraintStart_toStartOf="@id/txtDetailsName"
                app:layout_constraintTop_toBottomOf="@id/txtDetailsName"
                tools:text="عبدالله التميمي" />

            <!-- شارة الأمان والحزمة -->
            <TextView
                android:id="@+id/txtVerifiedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="?attr/colorSurfaceVariant"
                android:paddingHorizontal="10dp"
                android:paddingVertical="3dp"
                android:text="🛡️ مفحوص وآمن •نسخة رسمية"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                app:layout_constraintBottom_toBottomOf="@id/imgDetailsIcon"
                app:layout_constraintStart_toStartOf="@id/txtDetailsName"
                app:layout_constraintTop_toBottomOf="@id/txtDetailsDev" />

            <!-- ======================================================== -->
            <!-- 📊 2. بطاقة الإحصائيات الرباعية (التقييم، الإصدار، الحجم، التنزيلات) -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/imgDetailsIcon">

                <LinearLayout
                    android:id="@+id/layoutStatsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">

                    <!-- التقييم -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtStatRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="4.9 ★"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtStatReviewsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="التقييم"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.25" />

                    <!-- الإصدار -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtStatVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="2.26.28" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="الإصدار"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.25" />

                    <!-- الحجم -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtStatSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="124 MB" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="الحجم"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.25" />

                    <!-- التنزيلات -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtStatDownloads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="+10K" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="تنزيل"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 🚀 3. حاوية أزرار الإجراءات السحرية (تتبدل تلقائياً)      -->
            <!-- ======================================================== -->
            <FrameLayout
                android:id="@+id/containerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:animateLayoutChanges="true"
                app:layout_constraintTop_toBottomOf="@id/cardStatsContainer">

                <!-- الحالة الأولى: زر التنزيل / التثبيت الأساسي -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallState"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="تنزيل"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart" />

                <!-- الحالة الثانية: واجهة التحميل المتقدمة -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDownloadingState"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1dp"
                    tools:visibility="visible">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="8dp">

                        <ImageButton
                            android:id="@+id/btnCancelDownload"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_close"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/progressDownload"
                            app:layout_constraintStart_toEndOf="@id/btnCancelDownload"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvDownloadPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="جاري التنزيل... 0%"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDownloadSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0 MB / 0.0 MB"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressDownload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:max="100"
                            android:progress="35"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorSize="40dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:trackColor="?attr/colorSurface"
                            app:trackThickness="4dp" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- الحالة الثالثة: تم التثبيت (فتح / إلغاء التثبيت) -->
                <LinearLayout
                    android:id="@+id/layoutInstalledState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUninstall"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:text="إلغاء التثبيت"
                        android:textColor="?attr/colorError"
                        app:strokeColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenApp"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="فتح"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="28dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 🌟 صف أدوات ملف الـ APK (مشاركة + مسح جنباً إلى جنب) -->
            <LinearLayout
                android:id="@+id/layoutApkTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/containerActions">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareApk"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="مشاركة APK"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="?attr/colorPrimary"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteApk"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="مسح ملف التثبيت"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="?attr/colorError"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 📝 4. بطاقة لمحة عن التطبيق وما الجديد في التحديث         -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/layoutApkTools">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/lblAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 لمحة عن التطبيق وما الجديد"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        tools:text="ما الجديد في التحديث: تحسين الحماية ضد الحظر وإضافة ميزات جديدة..." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 💬 5. قسم تقييمات وتعليقات المستخدمين (Firebase Reviews) -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutCommentsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/cardDescription">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="💬 تعليقات المستخدمين"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddComment"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:text="إضافة تعليق"
                    android:textSize="12sp"
                    app:cornerRadius="20dp"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconSize="16dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/txtEmptyComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:paddingVertical="20dp"
                android:text="لا توجد تعليقات بعد. كن أول من يشارك تجربته لهذا التطبيق! ✨"
                android:textColor="?attr/colorOutline"
                android:textSize="13sp"
                android:visibility="visible"
                app:layout_constraintTop_toBottomOf="@id/layoutCommentsHeader" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintTop_toBottomOf="@id/layoutCommentsHeader" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
