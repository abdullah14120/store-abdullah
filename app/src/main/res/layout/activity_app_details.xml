<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.details.AppDetailsActivity">

    <!-- ======================================================== -->
    <!-- 1. الشريط العلوي المتكيف (يُظهر اسم وأيقونة التطبيق عند التمرير + أدوات APK) -->
    <!-- ======================================================== -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:elevation="0dp"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetails"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:paddingEnd="12dp"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="?attr/colorOnSurface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- عنوان وأيقونة مصغرة تظهر بنعومة عند التمرير للأسفل -->
                <LinearLayout
                    android:id="@+id/layoutToolbarMiniApp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingEnd="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgToolbarIcon"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="?attr/colorSurfaceVariant"
                        android:scaleType="centerCrop"
                        app:shapeAppearanceOverlay="@style/Shape.Medium"
                        tools:src="@mipmap/ic_launcher" />

                    <TextView
                        android:id="@+id/txtToolbarTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        tools:text="ABWhatsApp العنّابي" />
                </LinearLayout>

                <!-- أدوات ملف الـ APK الدائرية -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btnShareApk"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:clickable="true"
                    android:contentDescription="مشاركة APK"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="9dp"
                    android:src="@drawable/ic_details_share"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/Shape.Circle"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    app:tint="?attr/colorPrimary"
                    tools:visibility="visible" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/btnDeleteApk"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/colorSurfaceVariant"
                    android:clickable="true"
                    android:contentDescription="مسح ملف التثبيت"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless"
                    android:padding="9dp"
                    android:src="@drawable/ic_details_delete"
                    android:visibility="gone"
                    app:shapeAppearanceOverlay="@style/Shape.Circle"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp"
                    app:tint="?attr/colorError"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ======================================================== -->
    <!-- 2. المحتوى القابل للتمرير بالكامل بدون عوائق سفلية -->
    <!-- ======================================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollDetails"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="28dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ======================================================== -->
            <!-- 1. الهيدر الرئيسي: الأيقونة + الاسم + المطور + شارة الأمان -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutDetailsHero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_details_hero_wash"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="20dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="86dp"
                    android:layout_height="86dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="3dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgDetailsIcon"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:transitionName="transition_app_icon"
                        app:shapeAppearanceOverlay="@style/Shape.Medium"
                        tools:src="@mipmap/ic_launcher" />
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtDetailsName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-black"
                        android:includeFontPadding="false"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="2"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="ABWhatsApp العنّابي" />

                    <TextView
                        android:id="@+id/txtDetailsDev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="13.5sp"
                        tools:text="عبدالله التميمي" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_version_badge"
                        android:backgroundTint="?attr/colorPrimaryContainer"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">

                        <ImageView
                            android:layout_width="13dp"
                            android:layout_height="13dp"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="موثّق"
                            android:src="@drawable/ic_details_shield"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/txtVerifiedBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="آمن ومفحوص • نسخة رسمية"
                            android:textColor="?attr/colorOnPrimaryContainer"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 2. شريط الإحصائيات الأفقي المفتوح -->
            <!-- ======================================================== -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingHorizontal="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutStatsRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- كبسولة التقييم (قابلة للضغط) -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/layoutStatRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minWidth="92dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="التقييم"
                                android:src="@drawable/ic_details_star"
                                app:tint="#FFB300" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatRating"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:text="جديد"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtStatReviewsCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:text="قيّم الآن"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="10.5sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- كبسولة الإصدار -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minWidth="92dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="الإصدار"
                                android:src="@drawable/ic_details_version"
                                app:tint="?attr/colorPrimary" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatVersion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold"
                                    tools:text="2.26.39.80" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:text="الإصدار"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- كبسولة الحجم -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minWidth="92dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="الحجم"
                                android:src="@drawable/ic_details_size"
                                app:tint="?attr/colorPrimary" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatSize"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold"
                                    tools:text="86 MB" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:text="الحجم"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- كبسولة التنزيلات -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                        app:cardCornerRadius="18dp"
                        app:cardElevation="0dp"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:minWidth="92dp"
                            android:orientation="horizontal"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginEnd="8dp"
                                android:contentDescription="التنزيلات"
                                android:src="@drawable/ic_details_downloads"
                                app:tint="?attr/colorPrimary" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtStatDownloads"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold"
                                    tools:text="12.4K" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:maxLines="1"
                                    android:text="تنزيل"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="10.5sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ======================================================== -->
            <!-- 3. حاوية التنزيل والتثبيت (فوق لمحة عن التطبيق مباشرة) -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/floatingActionDock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <FrameLayout
                    android:id="@+id/containerActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:padding="6dp">

                    <!-- الحالة الأولى: زر التنزيل / التحديث / التثبيت الأساسي -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnInstallState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="52dp"
                        android:paddingVertical="10dp"
                        android:text="تنزيل"
                        android:textSize="15.5sp"
                        android:textStyle="bold"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="22dp"
                        app:icon="@drawable/ic_download"
                        app:iconGravity="textStart" />

                    <!-- الحالة الثانية: واجهة التحميل والتثبيت الحيّة -->
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/cardDownloadingState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="52dp"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="4dp"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/btnCancelDownload"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/colorSurfaceVariant"
                            android:clickable="true"
                            android:contentDescription="إلغاء التنزيل"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:padding="9dp"
                            android:src="@drawable/ic_close"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:shapeAppearanceOverlay="@style/Shape.Circle"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="10dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/progressDownload"
                            app:layout_constraintStart_toEndOf="@id/btnCancelDownload"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvDownloadPercent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="start|center_vertical"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="جاري التنزيل... 0%"
                                android:textAlignment="viewStart"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDownloadSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:ellipsize="end"
                                android:gravity="start|center_vertical"
                                android:includeFontPadding="false"
                                android:maxLines="1"
                                android:text="0.0 MB / 0.0 MB"
                                android:textAlignment="viewStart"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textDirection="locale"
                                android:textSize="11.5sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressDownload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:max="100"
                            android:progress="35"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorSize="40dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:trackColor="?attr/colorSurfaceVariant"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <!-- الحالة الثالثة: مثبت (فتح + إلغاء التثبيت) -->
                    <LinearLayout
                        android:id="@+id/layoutInstalledState"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUninstall"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="52dp"
                            android:paddingVertical="10dp"
                            android:text="إلغاء التثبيت"
                            android:textColor="?attr/colorError"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:cornerRadius="22dp"
                            app:strokeColor="?attr/colorError" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnOpenApp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="52dp"
                            android:paddingVertical="10dp"
                            android:text="فتح"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="?attr/colorPrimary"
                            app:cornerRadius="22dp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 4. بطاقة لمحة عن التطبيق (قابلة للطي + معلومات الحزمة التقنية) -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="22dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="19dp"
                            android:layout_height="19dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="لمحة عن التطبيق"
                            android:src="@drawable/ic_details_info"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/lblAbout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-black"
                            android:text="لمحة عن التطبيق وما الجديد"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:lineSpacingExtra="5dp"
                        android:maxLines="5"
                        android:textAlignment="viewStart"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13.5sp"
                        tools:text="ما الجديد في التحديث: تحسين الحماية ضد الحظر وإضافة ميزات جديدة مع استقرار أعلى وأداء أسرع..." />

                    <TextView
                        android:id="@+id/btnToggleDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="sans-serif-medium"
                        android:paddingVertical="4dp"
                        android:text="عرض المزيد ▾"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="12.5sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:visibility="visible" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="10dp"
                        android:alpha="0.35"
                        android:background="?attr/colorOutlineVariant" />

                    <LinearLayout
                        android:id="@+id/layoutPackageInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="2dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="معرّف الحزمة"
                            android:src="@drawable/ic_details_package"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="الحزمة:"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11.5sp" />

                        <TextView
                            android:id="@+id/txtPackageNameInfo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:layout_weight="1"
                            android:ellipsize="middle"
                            android:fontFamily="monospace"
                            android:maxLines="1"
                            android:textAlignment="viewStart"
                            android:textColor="?attr/colorOnSurface"
                            android:textDirection="ltr"
                            android:textSize="11.5sp"
                            tools:text="com.whatsapp.abdullah" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="نسخ"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 5. قسم التقييمات والمراجعات المدمج والخفيف -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutCommentsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-black"
                        android:text="التقييمات والمراجعات"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtRatingSummaryInline"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="12sp"
                        android:visibility="gone"
                        tools:text="★ 4.8 • 12 مراجعة"
                        tools:visibility="visible" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddComment"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:paddingHorizontal="14dp"
                    android:text="أضف تقييمك"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:cornerRadius="18dp"
                    app:icon="@drawable/ic_details_edit"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="15dp" />
            </LinearLayout>

            <!-- رسالة الحالة الفارغة الهادئة والمدمجة -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardEmptyComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <TextView
                    android:id="@+id/txtEmptyComments"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp"
                    android:text="لا توجد مراجعات بعد — كن أول من يقيّم هذا التطبيق ✨"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="12.5sp" />
            </com.google.android.material.card.MaterialCardView>

            <!-- أحدث 3 مراجعات فقط -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvComments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <!-- زر عرض كل المراجعات (يظهر فقط عند وجود أكثر من 3 مراجعات) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowAllReviews"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:text="عرض كل المراجعات"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:cornerRadius="16dp"
                tools:visibility="visible" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
