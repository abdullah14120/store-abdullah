<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.details.AppDetailsActivity">

    <!-- 1. شريط علوي يندمج مع الخلفية ويبرز عند التمرير -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetails"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="?attr/colorOnSurface"
            app:titleCentered="true"
            tools:title="تفاصيل التطبيق" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="48dp">

            <!-- ======================================================== -->
            <!-- 🎨 1. قسم الهيدر: الأيقونة، الاسم، المطور، وشارة الأمان -->
            <!-- ======================================================== -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDetailsIcon"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:background="?attr/colorSurfaceVariant"
                android:scaleType="centerCrop"
                android:transitionName="transition_app_icon"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/Shape.Medium"
                tools:src="@tools/sample/avatars" />

            <TextView
                android:id="@+id/txtDetailsName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="24dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:lineSpacingExtra="2dp"
                android:maxLines="3"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurface"
                android:textSize="19sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgDetailsIcon"
                app:layout_constraintTop_toTopOf="@id/imgDetailsIcon"
                tools:text="ABWhatsApp العنّابي" />

            <TextView
                android:id="@+id/txtDetailsDev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorPrimary"
                android:textSize="13.5sp"
                app:layout_constraintEnd_toEndOf="@id/txtDetailsName"
                app:layout_constraintStart_toStartOf="@id/txtDetailsName"
                app:layout_constraintTop_toBottomOf="@id/txtDetailsName"
                tools:text="عبدالله التميمي" />

            <!-- شارة الأمان والحزمة (تتمدد بأمان مع الخطوط الكبيرة) -->
            <TextView
                android:id="@+id/txtVerifiedBadge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/bg_version_badge"
                android:backgroundTint="?attr/colorSurfaceVariant"
                android:ellipsize="end"
                android:maxLines="2"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🛡️ مفحوص وآمن • نسخة رسمية"
                android:textAlignment="viewStart"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="@id/txtDetailsName"
                app:layout_constraintTop_toBottomOf="@id/txtDetailsDev"
                app:layout_constraintWidth_default="wrap" />

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/barrierHeaderBottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="imgDetailsIcon,txtVerifiedBadge" />

            <!-- ======================================================== -->
            <!-- 📊 2. بطاقة الإحصائيات الرباعية (التقييم، الإصدار، الحجم، التنزيلات) -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="22dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@id/barrierHeaderBottom">

                <LinearLayout
                    android:id="@+id/layoutStatsRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingVertical="14dp">

                    <!-- التقييم (قابل للضغط لفتح نافذة التقييم مباشرة) -->
                    <LinearLayout
                        android:id="@+id/layoutStatRating"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingHorizontal="4dp">
                        <TextView
                            android:id="@+id/txtStatRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="5.0 ★"
                            android:textColor="#FFB300"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/txtStatReviewsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="قيّم الآن"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.25" />

                    <!-- الإصدار -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtStatVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="2.26.28" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="الإصدار"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.25" />

                    <!-- الحجم -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtStatSize"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="124 MB" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="الحجم"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="28dp"
                        android:background="?attr/colorOutline"
                        android:alpha="0.25" />

                    <!-- التنزيلات -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/txtStatDownloads"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            tools:text="+10K" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="تنزيل"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- 🚀 3. حاوية أزرار الإجراءات السحرية (تتبدل تلقائياً)      -->
            <!-- ======================================================== -->
            <FrameLayout
                android:id="@+id/containerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="20dp"
                android:animateLayoutChanges="true"
                app:layout_constraintTop_toBottomOf="@id/cardStatsContainer">

                <!-- الحالة الأولى: زر التنزيل / التثبيت الأساسي (يتمدد بمرونة مع الخطوط الكبيرة) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="56dp"
                    android:paddingVertical="10dp"
                    android:text="تنزيل"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="28dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart" />

                <!-- الحالة الثانية: واجهة التحميل المتقدمة (مرنة بالكامل مع جميع أحجام الخطوط والنصوص الطويلة) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDownloadingState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorPrimary"
                    app:strokeWidth="1.5dp"
                    tools:visibility="visible">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="72dp"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="12dp">

                        <ImageButton
                            android:id="@+id/btnCancelDownload"
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="إلغاء التنزيل"
                            android:src="@drawable/ic_close"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="10dp"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/progressDownload"
                            app:layout_constraintStart_toEndOf="@id/btnCancelDownload"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvDownloadPercent"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:gravity="start|center_vertical"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:text="جاري التنزيل... 0%"
                                android:textAlignment="viewStart"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="13.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDownloadSize"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:ellipsize="end"
                                android:gravity="start|center_vertical"
                                android:includeFontPadding="false"
                                android:lineSpacingExtra="2dp"
                                android:maxLines="2"
                                android:text="0.0 MB / 0.0 MB"
                                android:textAlignment="viewStart"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textDirection="locale"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressDownload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="4dp"
                            android:max="100"
                            android:progress="35"
                            app:indicatorColor="?attr/colorPrimary"
                            app:indicatorSize="42dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:trackColor="?attr/colorSurface"
                            app:trackCornerRadius="2dp"
                            app:trackThickness="4dp" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- الحالة الثالثة: تم التثبيت (فتح / إلغاء التثبيت) -->
                <LinearLayout
                    android:id="@+id/layoutInstalledState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUninstall"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:minHeight="56dp"
                        android:paddingVertical="10dp"
                        android:text="إلغاء التثبيت"
                        android:textColor="?attr/colorError"
                        app:strokeColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenApp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:minHeight="56dp"
                        android:paddingVertical="10dp"
                        android:text="فتح"
                        app:backgroundTint="?attr/colorPrimary"
                        app:cornerRadius="28dp" />
                </LinearLayout>
            </FrameLayout>

            <!-- 🌟 صف أدوات ملف الـ APK (مشاركة + مسح جنباً إلى جنب) -->
            <LinearLayout
                android:id="@+id/layoutApkTools"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/containerActions">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShareApk"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="مشاركة APK"
                    android:textColor="?attr/colorPrimary"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_share"
                    app:iconTint="?attr/colorPrimary"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeleteApk"
                    style="@style/Widget.Material3.Button.TextButton.Icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="مسح ملف التثبيت"
                    android:textColor="?attr/colorError"
                    android:visibility="gone"
                    app:icon="@android:drawable/ic_menu_delete"
                    app:iconTint="?attr/colorError"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- ======================================================== -->
            <!-- 📝 4. بطاقة لمحة عن التطبيق وما الجديد في التحديث         -->
            <!-- ======================================================== -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="?attr/colorSurfaceVariant"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp"
                app:layout_constraintTop_toBottomOf="@id/layoutApkTools">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/lblAbout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📦 لمحة عن التطبيق وما الجديد"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="6dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp"
                        tools:text="ما الجديد في التحديث: تحسين الحماية ضد الحظر وإضافة ميزات جديدة..." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ======================================================== -->
            <!-- ⭐ 5. لوحة التقييم الاحترافية وصندوق مراجعات المستخدمين    -->
            <!-- ======================================================== -->
            <LinearLayout
                android:id="@+id/layoutCommentsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@id/cardDescription">

                <!-- عنوان القسم -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⭐ التقييمات والمراجعات"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtQuickRateHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_version_badge"
                        android:backgroundTint="?attr/colorSurfaceVariant"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:text="موثّق 🛡️"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- بطاقة التقييم التفاعلية الفخمة (على غرار المتاجر العالمية) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardQuickRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardBackgroundColor="?attr/colorSurfaceVariant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="?attr/colorOutlineVariant"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <!-- صف ملخص التقييم العام -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:minWidth="76dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/txtRatingBigScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="sans-serif-black"
                                    android:includeFontPadding="false"
                                    android:text="5.0"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="34sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtRatingBigStars"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="★★★★★"
                                    android:textColor="#FFB300"
                                    android:textSize="13sp" />

                                <TextView
                                    android:id="@+id/txtRatingBigCount"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="تقييم المتجر"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="58dp"
                                android:layout_marginHorizontal="16dp"
                                android:alpha="0.25"
                                android:background="?attr/colorOutline" />

                            <!-- منطقة التقييم التفاعلي السريع بالنجوم -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center_horizontal"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:text="قيّم هذا التطبيق الآن"
                                    android:textColor="?attr/colorOnSurface"
                                    android:textSize="13.5sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:gravity="center"
                                    android:text="اضغط على النجمة المناسبة لتجربتك"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:textSize="11sp" />

                                <!-- شريط النجوم التفاعلي المباشر -->
