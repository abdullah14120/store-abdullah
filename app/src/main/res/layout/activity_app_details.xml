<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".ui.details.AppDetailsActivity">

    <!-- شريط علوي يندمج مع الخلفية ويبرز عند التمرير -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        app:liftOnScroll="true">
        
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetails"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="?attr/colorOnSurface"
            app:titleCentered="true"
            tools:title="تفاصيل التطبيق" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- استخدام ConstraintLayout لأداء صاروخي وتنسيق مرن -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="60dp">

            <!-- 1. قسم الهيدر: الأيقونة واسم التطبيق -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgDetailsIcon"
                android:layout_width="96dp" 
                android:layout_height="96dp"
                android:layout_marginStart="24dp"
                android:layout_marginTop="16dp"
                android:scaleType="centerCrop" 
                android:transitionName="transition_app_icon"
                app:shapeAppearanceOverlay="@style/Shape.Medium" 
                android:background="?attr/colorSurfaceVariant"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools/sample/avatars" />

            <TextView
                android:id="@+id/txtDetailsName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="24dp"
                android:fontFamily="sans-serif-black"
                android:textAppearance="?attr/textAppearanceHeadlineSmall"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/imgDetailsIcon"
                app:layout_constraintTop_toTopOf="@id/imgDetailsIcon"
                app:layout_constraintBottom_toTopOf="@id/txtDetailsDev"
                app:layout_setVerticalChainStyle="packed"
                tools:text="FIX ENGINE PRO" />

            <TextView
                android:id="@+id/txtDetailsDev"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="?attr/colorPrimary"
                android:textSize="14sp" 
                app:layout_constraintEnd_toEndOf="@id/txtDetailsName"
                app:layout_constraintStart_toStartOf="@id/txtDetailsName"
                app:layout_constraintTop_toBottomOf="@id/txtDetailsName"
                app:layout_constraintBottom_toBottomOf="@id/imgDetailsIcon"
                tools:text="Abdullah Al-Tamimi" />

            <!-- 2. شريط الإحصائيات (تقييم، حجم، تنزيلات) بأسلوب جوجل بلاي -->
            <LinearLayout
                android:id="@+id/layoutStatsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/imgDetailsIcon">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtStatVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="v1.4.2" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOutline"
                        android:text="الإصدار" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="?attr/colorSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtStatSize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="45 MB" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOutline"
                        android:text="الحجم" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="24dp"
                    android:background="?attr/colorSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtStatDownloads"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="+10K" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="?attr/colorOutline"
                        android:text="تنزيل" />
                </LinearLayout>
            </LinearLayout>

            <!-- 🌟 3. حاوية أزرار الإجراءات السحرية (تتبدل تلقائياً بأنيميشن) -->
            <FrameLayout
                android:id="@+id/containerActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:animateLayoutChanges="true"
                app:layout_constraintTop_toBottomOf="@id/layoutStatsRow">

                <!-- الحالة الأولى: زر التنزيل الأساسي (Idle) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallState"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="تثبيت"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="28dp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:icon="@drawable/ic_download" 
                    app:iconGravity="textStart" />

                <!-- الحالة الثانية: واجهة التحميل المتقدمة (Downloading) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDownloadingState"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    app:cardBackgroundColor="?attr/colorSurfaceContainer"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="?attr/colorSurfaceVariant"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:paddingHorizontal="8dp">

                        <!-- زر الإلغاء -->
                        <ImageButton
                            android:id="@+id/btnCancelDownload"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_close" 
                            app:tint="?attr/colorOnSurfaceVariant"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <!-- النصوص (الحجم والنسبة) -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp"
                            android:layout_marginEnd="12dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/progressDownload"
                            app:layout_constraintStart_toEndOf="@id/btnCancelDownload"
                            app:layout_constraintTop_toTopOf="parent">

                            <TextView
                                android:id="@+id/tvDownloadPercent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="جاري التنزيل... 0%"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDownloadSize"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0 MB / 0.0 MB"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- شريط التقدم الدائري -->
                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/progressDownload"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:max="100"
                            android:progress="35"
                            app:indicatorColor="?attr/colorPrimary"
                            app:trackColor="?attr/colorSurfaceVariant"
                            app:indicatorSize="40dp"
                            app:trackThickness="4dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- الحالة الثالثة: تم التثبيت (Installed) -->
                <LinearLayout
                    android:id="@+id/layoutInstalledState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUninstall"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:text="إلغاء التثبيت"
                        android:textColor="?attr/colorError"
                        app:strokeColor="?attr/colorError" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOpenApp"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="فتح"
                        app:cornerRadius="28dp"
                        app:backgroundTint="?attr/colorPrimary" />
                </LinearLayout>
            </FrameLayout>

            <!-- 4. قسم الوصف -->
            <TextView
                android:id="@+id/lblAbout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="32dp"
                android:text="لمحة عن التطبيق"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/containerActions" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="6dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblAbout"
                tools:text="هذا النص هو مساحة لوصف التطبيق، يمكنك إضافة ميزات التطبيق هنا. التصميم الجديد يدعم النصوص الطويلة بسلاسة..." />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
