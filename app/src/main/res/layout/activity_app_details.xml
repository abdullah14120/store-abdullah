<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dark_background"
        app:elevation="0dp">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarDetails"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator"
            app:navigationIconTint="@color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- القسم العلوي: الأيقونة والاسم -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgDetailsIcon"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    app:shapeAppearanceOverlay="@style/RoundedIcon"
                    android:background="#1A222C"
                    android:elevation="8dp"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/avatars" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="20dp">

                    <TextView
                        android:id="@+id/txtDetailsName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="26sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:fontFamily="sans-serif-black"
                        tools:text="اسم التطبيق" />

                    <TextView
                        android:id="@+id/txtDetailsDev"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textColor="@color/secondary_cyan"
                        android:textStyle="bold"
                        tools:text="المطور المعتمد"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- منطقة التفاعل: زر التثبيت أو شريط التحميل -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInstallLarge"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:text="تثبيت الآن"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/dark_background"
                    app:backgroundTint="@color/secondary_cyan"
                    app:cornerRadius="18dp"
                    android:elevation="4dp"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/layoutDownloadProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:background="#1A222C"
                    android:padding="16dp"
                    android:elevation="2dp">

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/downloadProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:trackThickness="12dp"
                        app:trackCornerRadius="6dp"
                        android:progress="30"
                        app:indicatorColor="@color/secondary_cyan"
                        app:trackColor="#2D3748" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp">

                        <TextView
                            android:id="@+id/txtDownloadSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:textColor="@color/gray_light"
                            tools:text="جاري التجهيز..." />

                        <TextView
                            android:id="@+id/txtDownloadETA"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerHorizontal="true"
                            android:textSize="13sp"
                            android:textColor="@color/gray_light"
                            tools:text="15.2 MB / 40 MB" />

                        <TextView
                            android:id="@+id/txtDownloadPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/secondary_cyan"
                            tools:text="30%" />
                    </RelativeLayout>
                </LinearLayout>
            </FrameLayout>

            <!-- كبسولات المعلومات (الإصدار والحجم) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="36dp"
                android:background="#121B26"
                android:paddingVertical="16dp"
                android:paddingHorizontal="8dp">

                <include layout="@layout/layout_info_badge" android:id="@+id/badgeVersion" />
                <View android:layout_width="1dp" android:layout_height="35dp" android:background="#2D3748" android:layout_marginHorizontal="20dp"/>
                <include layout="@layout/layout_info_badge" android:id="@+id/badgeSize" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2D3748"
                android:layout_marginTop="36dp" />

            <!-- وصف التطبيق -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="عن هذا التطبيق"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:layout_marginTop="28dp" />

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textSize="16sp"
                android:textColor="@color/gray_light"
                android:lineSpacingExtra="10dp"
                android:alpha="0.9"
                tools:text="وصف التطبيق الاحترافي يظهر هنا بتنسيق مريح للعين يدعم النصوص الطويلة والشرح المفصل للمميزات التي يقدمها متجر عبدالله..." />

            <!-- تذييل الصفحة لإعطاء مساحة تنفس -->
            <View
                android:layout_width="match_parent"
                android:layout_height="100dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
