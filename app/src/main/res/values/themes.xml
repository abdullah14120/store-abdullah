<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    
    <style name="Theme.FixEngine" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_theme_d_primary</item>
        <item name="colorOnPrimary">@color/md_theme_d_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_d_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_d_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_d_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_d_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_d_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_d_onSecondaryContainer</item>

        <item name="android:colorBackground">@color/md_theme_d_background</item>
        <item name="colorSurface">@color/md_theme_d_surface</item>
        <item name="colorOnSurface">@color/md_theme_d_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_d_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_d_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_d_outline</item>

        <item name="android:statusBarColor">@color/md_theme_d_surfaceContainer</item>
        <item name="android:navigationBarColor">@color/md_theme_d_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item> 
        
        <item name="materialButtonStyle">@style/Widget.FixEngine.Button</item>
        <item name="materialCardViewStyle">@style/Theme.Card</item>
        <item name="materialAlertDialogTheme">@style/Theme.FixEngine.Dialog</item>

        <item name="android:textColorPrimary">@color/md_theme_d_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_d_onSurfaceVariant</item>
        <item name="textAppearanceHeadlineMedium">@style/HeadlineMedium</item>
    </style>

    <style name="Theme.FixEngine.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item> 
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item> 
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/shape_large_corner</item>

        <item name="colorPrimary">@color/md_theme_d_primary</item>
        <item name="colorOnSurface">@color/md_theme_d_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_d_onSurface</item>
    </style>

    <style name="Widget.FixEngine.Button" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="cornerRadius">@dimen/shape_large_corner</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.FixEngine.Toolbar" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/md_theme_d_onSurface</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">32sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">@dimen/shape_large_corner</item>
    </style>

    <style name="RoundedIcon">
        <item name="cornerSize">@dimen/shape_large_corner</item>
    </style>

    <style name="Shape.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/shape_small_corner</item>
    </style>

    <style name="Shape.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/shape_medium_corner</item>
    </style>

    <style name="Shape.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.FixEngine.Badge" parent="Widget.Material3.Badge">
        <item name="backgroundColor">#EF4444</item>
        <item name="badgeTextColor">#FFFFFF</item>
    </style>

    <style name="CustomTabText">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style> 

</resources>
