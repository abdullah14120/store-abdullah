<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ☀️ الثيم النهاري الفاتح (يعمل تلقائياً عند اختيار الوضع النهاري) -->
    <style name="Theme.FixEngine" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">#1B6D2F</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#A4F5A9</item>
        <item name="colorOnPrimaryContainer">#002106</item>

        <item name="colorSecondary">#526350</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#D4E8D0</item>
        <item name="colorOnSecondaryContainer">#101F10</item>

        <item name="android:colorBackground">#F7FBF2</item>
        <item name="colorSurface">#F7FBF2</item>
        <item name="colorSurfaceContainerLow">#F1F5EC</item>
        <item name="colorSurfaceContainer">#EBF0E7</item>
        <item name="colorOnSurface">#181D18</item>
        <item name="colorSurfaceVariant">#DEE5D9</item>
        <item name="colorOnSurfaceVariant">#424940</item>
        <item name="colorOutline">#72796F</item>
        <item name="colorOutlineVariant">#C2C9BD</item>

        <item name="colorError">#BA1A1A</item>
        <item name="colorOnError">#FFFFFF</item>

        <item name="android:statusBarColor">#F7FBF2</item>
        <item name="android:navigationBarColor">#F7FBF2</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="materialButtonStyle">@style/Widget.FixEngine.Button</item>
        <item name="materialCardViewStyle">@style/Theme.Card</item>
        <item name="materialAlertDialogTheme">@style/Theme.FixEngine.Dialog</item>

        <item name="android:textColorPrimary">#181D18</item>
        <item name="android:textColorSecondary">#424940</item>
        <item name="textAppearanceHeadlineMedium">@style/HeadlineMedium</item>
    </style>

    <style name="Theme.FixEngine.Dialog" parent="Theme.Material3.Light.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/shape_large_corner</item>

        <item name="colorSurface">#F1F5EC</item>
        <item name="colorPrimary">#1B6D2F</item>
        <item name="colorOnSurface">#181D18</item>
        <item name="android:textColorPrimary">#181D18</item>
    </style>

    <!-- الستايلات المشتركة بين الوضعين النهاري والليلي -->
    <style name="Widget.FixEngine.Button" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="cornerRadius">@dimen/shape_large_corner</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="TextAppearance.FixEngine.Toolbar" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <style name="HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">24sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="lineHeight">32sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Theme.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@android:color/transparent</item>
        <item name="cardCornerRadius">@dimen/shape_large_corner</item>
    </style>

    <style name="RoundedIcon">
        <item name="cornerSize">@dimen/shape_large_corner</item>
    </style>

    <style name="Shape.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">@dimen/shape_small_corner</item>
    </style>

    <style name="Shape.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">@dimen/shape_medium_corner</item>
    </style>

    <style name="Shape.Circle" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.FixEngine.Badge" parent="Widget.Material3.Badge">
        <item name="backgroundColor">#EF4444</item>
        <item name="badgeTextColor">#FFFFFF</item>
    </style>

    <style name="CustomTabText">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

</resources>
