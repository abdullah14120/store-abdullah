<resources xmlns:tools="http://schemas.android.com/tools">
    
    <!-- الثيم الرئيسي للمتجر (FIX ENGINE) -->
    <style name="Theme.FixEngine" parent="Theme.Material3.Dark.NoActionBar"> <!-- الترقية لـ Material3 ضرورية لـ SDK 35 -->
        <!-- الألوان الأساسية -->
        <item name="colorPrimary">#22D3EE</item> 
        <item name="colorOnPrimary">#0F172A</item>
        <item name="containerColor">#1E293B</item>

        <!-- خلفية النظام -->
        <item name="android:windowBackground">#0F172A</item>
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item> 
        
        <!-- تخصيص العناصر التفاعلية -->
        <item name="materialButtonStyle">@style/Widget.FixEngine.Button</item>
        
        <!-- ألوان النصوص -->
        <item name="android:textColorPrimary">#F8FAFC</item>
        <item name="android:textColorSecondary">#94A3B8</item>

        <!-- الربط الصحيح للديالوج لمنع الانهيار -->
        <item name="materialAlertDialogTheme">@style/Theme.FixEngine.Dialog</item>
    </style>

    <!-- +++++ ستايل الديالوج المحدث (حل مشكلة الانهيار) +++++ -->
    <style name="Theme.FixEngine.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <!-- تأمين الخلفية والأبعاد لمنع خطأ supply a layout_width -->
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        
        <!-- ألوان المحتوى -->
        <item name="colorOnSurface">#F8FAFC</item>
        <item name="android:textColorPrimary">#F8FAFC</item>
    </style>

    <!-- ستايل الأزرار (Premium Feel) -->
    <style name="Widget.FixEngine.Button" parent="Widget.Material3.Button.UnelevatedButton">
        <item name="shapeAppearanceOverlay">@style/ButtonRounded</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="ButtonRounded">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- ستايل نصوص التولبار -->
    <style name="TextAppearance.FixEngine.Toolbar" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">#F8FAFC</item>
        <item name="android:fontFamily">sans-serif-black</item>
    </style>

    <!-- تصميم الأيقونات (نمط Squircle) -->
    <style name="RoundedIcon">
        <item name="cornerSize">22dp</item>
    </style>

    <!-- ستايل الصور الدائرية -->
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <!-- ستايل الخطوط للتبويبات (Tabs) -->
    <style name="CustomTabText">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

</resources>
