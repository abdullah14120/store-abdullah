<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF"> <!-- تأثير الضغط الأبيض الشفاف -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#22D3EE"
                android:endColor="#0891B2"
                android:angle="45" />
            <corners android:radius="24dp" /> <!-- حواف دائرية بالكامل -->
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="8dp"
                android:bottom="8dp" />
        </shape>
    </item>
</ripple>
