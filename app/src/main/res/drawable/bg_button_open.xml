<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#20FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1E293B" /> <!-- لون كحلي متناسق مع الثيم -->
            <stroke
                android:width="1dp"
                android:color="#334155" />
            <corners android:radius="24dp" />
            <padding
                android:left="16dp"
                android:right="16dp"
                android:top="8dp"
                android:bottom="8dp" />
        </shape>
    </item>
</ripple>
