<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- لون خلفية الديالوج: الكحلي الغامق المتوافق مع الثيم الرئيسي -->
    <solid android:color="#1E293B" />

    <!-- إطار رقيق جداً ليعطي عمقاً (Stroke) يشبه المتاجر العالمية -->
    <stroke
        android:width="1dp"
        android:color="#334155" />

    <!-- انحناء الزوايا بشكل احترافي (28dp) ليتناسب مع لغة التصميم الحديثة -->
    <corners android:radius="28dp" />

    <!-- إضافة مساحة داخلية لضمان عدم التصاق النصوص بالحواف -->
    <padding
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp" />
</shape>
