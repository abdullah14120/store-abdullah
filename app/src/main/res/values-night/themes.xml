<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 🌙 الثيم الليلي الداكن الأصلي للمتجر -->
    <style name="Theme.FixEngine" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/md_theme_d_primary</item>
        <item name="colorOnPrimary">@color/md_theme_d_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_d_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_d_onPrimaryContainer</item>

        <item name="colorSecondary">@color/md_theme_d_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_d_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_d_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_d_onSecondaryContainer</item>

        <item name="android:colorBackground">@color/md_theme_d_background</item>
        <item name="colorSurface">@color/md_theme_d_surface</item>
        <item name="colorSurfaceContainerLow">@color/md_theme_d_surfaceContainer</item>
        <item name="colorSurfaceContainer">@color/md_theme_d_surfaceContainer</item>
        <item name="colorOnSurface">@color/md_theme_d_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_d_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_d_onSurfaceVariant</item>
        <item name="colorOutline">@color/md_theme_d_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_d_outlineVariant</item>

        <item name="colorError">@color/md_theme_d_error</item>
        <item name="colorOnError">@color/md_theme_d_onError</item>

        <item name="android:statusBarColor">@color/md_theme_d_surfaceContainer</item>
        <item name="android:navigationBarColor">@color/md_theme_d_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>

        <item name="materialButtonStyle">@style/Widget.FixEngine.Button</item>
        <item name="materialCardViewStyle">@style/Theme.Card</item>
        <item name="materialAlertDialogTheme">@style/Theme.FixEngine.Dialog</item>

        <item name="android:textColorPrimary">@color/md_theme_d_onSurface</item>
        <item name="android:textColorSecondary">@color/md_theme_d_onSurfaceVariant</item>
        <item name="textAppearanceHeadlineMedium">@style/HeadlineMedium</item>
    </style>

    <style name="Theme.FixEngine.Dialog" parent="Theme.Material3.Dark.Dialog.Alert">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
        <item name="android:dialogCornerRadius" tools:targetApi="p">@dimen/shape_large_corner</item>

        <item name="colorSurface">@color/md_theme_d_surfaceContainer</item>
        <item name="colorPrimary">@color/md_theme_d_primary</item>
        <item name="colorOnSurface">@color/md_theme_d_onSurface</item>
        <item name="android:textColorPrimary">@color/md_theme_d_onSurface</item>
    </style>

</resources>
