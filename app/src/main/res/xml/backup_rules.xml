<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- 🟢 تضمين الإعدادات وقواعد البيانات المهمة فقط -->
    <include domain="sharedpref" path="." />
    <include domain="database" path="." />
    
    <!-- ❌ استثناء مجلدات التحميلات والكاش لمنع رفع ملفات الـ APK الثقيلة وسرقة مساحة السحابة -->
    <exclude domain="file" path="downloads" />
    <exclude domain="file" path="Download" />
    <exclude domain="external" path="." />
    <exclude domain="root" path="cache" />
</full-backup-content>
