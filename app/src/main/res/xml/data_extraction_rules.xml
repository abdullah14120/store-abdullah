<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude path="files/downloads" />
        <exclude path="external_files/Download" />
        
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>

    <device-transfer>
        <include domain="file" path="." />
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <exclude path="cache" />
    </device-transfer>
</data-extraction-rules>
