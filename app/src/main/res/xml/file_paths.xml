<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 🟢 الحل الشامل لمجلد التنزيلات العام (DownloadManager) بدون تقييد -->
    <external-path name="all_external_storage" path="." />
    
    <!-- 🟢 لتأمين مجلد التنزيلات الخاص بالتطبيق لـ minSdk 23 وما فوق -->
    <external-files-path name="external_files" path="." />
    
    <!-- 🟢 مسارات احتياطية لتغطية الـ Cache والملفات الداخلية منعاً لأي كراش -->
    <cache-path name="internal_cache" path="." />
    <external-cache-path name="external_cache" path="." />
    <files-path name="internal_files" path="." />
</paths>
